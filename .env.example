# Token from @BotFather
BOT_TOKEN=123456:ABC-your-token-here
# kick = remove but allow rejoining later, ban = block permanently
ACTION=kick
# Also treat bare @username mentions in the bio as Telegram links
MATCH_MENTIONS=false
# Recent members (joined less than this many days ago) are re-checked when they post
NEW_MEMBER_DAYS=14
# Where join dates are stored
DB_PATH=members.db
